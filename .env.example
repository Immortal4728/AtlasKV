# AtlasKV Environment Configuration Reference
# Use this template for configuring AtlasKV nodes in containerized / cloud deployments.

# ── Node Identity ──
NODE_ID=node1
RAFT_NODE_ID=node1

# ── Network Binding & Ports ──
REST_BIND_HOST=0.0.0.0
SERVER_PORT=8081
REST_PORT=8081
GRPC_BIND_HOST=0.0.0.0
GRPC_PORT=50051

# ── Host Port Mapping (for docker-compose) ──
NODE1_REST_PORT=8081
NODE2_REST_PORT=8082
NODE3_REST_PORT=8083

# ── Storage Directory ──
RAFT_DATA_DIR=/app/data
DATA_DIRECTORY=/app/data

# ── Cluster Peers (Format: id:host:port,id:host:port or id=host:port) ──
CLUSTER_MEMBERS=node1:atlaskv-node1:50051,node2:atlaskv-node2:50052,node3:atlaskv-node3:50053
PEER_NODES=node1:atlaskv-node1:50051,node2:atlaskv-node2:50052,node3:atlaskv-node3:50053

# ── REST API Security & Identity (Phase 2.2 / 2.5) ──
# Disabled by default for local development. Set to true to require authentication.
AUTH_ENABLED=false
# Secret API token. When AUTH_ENABLED=true, this token is used to create the
# initial Administrator identity. Requests must include this token via:
#   Authorization: Bearer <token>
#   Authorization: ApiKey <token>
#   X-API-Key: <token>
AUTH_TOKEN=
# Display name for the default Administrator user (optional, default: "Administrator")
ADMIN_USERNAME=Administrator
# Roles: ADMIN (full access), USER (standard API access)
# The AUTH_TOKEN automatically creates an ADMIN user. Additional users and keys
# can be registered programmatically via the AuthenticationService.

# ── Logging ──
LOG_LEVEL=INFO

# ── AtlasKV Studio (Web Management Console) ──
STUDIO_PORT=3000
BACKEND_URL=http://atlaskv-node1:8081
